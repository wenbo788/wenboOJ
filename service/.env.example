# ---- Database ----
# Local dev needs NO .env file: the app defaults to a local SQLite file
# (sqlite+aiosqlite:///./oj.db). Copy this file to .env and set DATABASE_URL
# below only when you want to target PostgreSQL (e.g. production). When ENV=prod,
# a SQLite URL is rejected at startup.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oj_service

# ---- Auth ----
# Leave JWT_SECRET empty in dev: a random per-process secret is auto-generated
# (tokens invalidate on each restart — fine, even helpful, in dev).
# It MUST be set explicitly when ENV=prod. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 阿里云 ESA AI CAPTCHA。只有两条登录规则生效、前端 prefix/SceneId 已配置后才设 true。
# true 时 /auth/login 与兼容登录入口 /tokens 都拒绝缺少 captcha_verify_param 的请求。
ESA_CAPTCHA_REQUIRED=false

# ---- Runtime ----
# dev | prod   (prod requires JWT_SECRET, a PostgreSQL DATABASE_URL and a real FRONTEND_URL)
ENV=dev

# 额外允许的跨域来源（逗号分隔）。把前端部署到 GitHub Pages 时填 Pages 的 origin：
#   CORS_EXTRA_ORIGINS=https://yourname.github.io
# 只填 scheme+host（不要带 /<repo>/ 路径），改完重启后端。
# CORS_EXTRA_ORIGINS=

# ---- 防滥用 / 过载保护（见 app/core/guard.py）----
# 被打时源站不能把请求堆在队列里干等——Cloudflare 等不到响应就是 522。
# 不设任何项即为默认：ENV=prod 时启用，数值见 core/config.py。
# GUARD_ENABLED=false              # 显式关掉（不建议）
# GUARD_RATE_MAX=600               # 单 IP 每 GUARD_RATE_WINDOW 秒的请求上限；0/负数=关
# GUARD_BURST_MAX=120              # 单 IP 每 GUARD_BURST_WINDOW 秒的突发上限（挡 CC）；0/负数=关
# GUARD_MAX_CONCURRENCY=64         # 全站同时在处理的请求数上限，满了立刻 503（不排队）
# GUARD_MAX_PER_IP_CONCURRENCY=48  # 单 IP 并发上限；被单一来源攻击时可临时调到 8~16
# GUARD_RATE_STATUS=502            # 限流后对外的状态码。默认 502 = 装成上游挂了；
#                                  # 想按 RFC 6585 明说「你被限流了」就改成 429
#                                  # （429 会带 Retry-After，见 core/guard.py）
#
# 注意：学校/机房大量用户共用一个出口 IP 时按 IP 限速会误伤——优先调大
# GUARD_RATE_MAX / GUARD_BURST_MAX，或把这两项设成 0，只留并发保护。

# ---- 评测机（go-judge）----
# 主用：宿主机上的 go-judge systemd 服务。docker-compose 里已固定成
# host.docker.internal:5050（容器经 docker 网桥访问宿主机），一般不用改。
# GO_JUDGE_URL=http://host.docker.internal:5050
#
# 备用：逗号分隔，可配多台，**按顺序**做故障转移。
# 只有在主用连不上 / 返回 5xx 时才会启用；正常时流量不会分流到备用，
# 属于「备用机」而不是负载均衡。
# 切换的最小单位是「一整份提交」：编译产物（fileId）只存在于编译它的那台，
# 所以主用挂了会把这份提交整份重跑到备用，不会跨机器混用。
# GO_JUDGE_FALLBACK_URLS=http://152.136.230.31:5050
#
# 某台失败后的冷却秒数：期间优先用其它评测机，
# 免得主用瘫痪后每条提交都要先白等一次连接超时。
# GO_JUDGE_FAILOVER_COOLDOWN_SECONDS=60
#
# ⚠️ 安全：go-judge 没有任何鉴权，且它的职责就是执行任意选手代码。
#    公网上的备用评测机务必在云安全组 + 主机防火墙上只放行 OJ 服务器的出口 IP，
#    绝不要对 0.0.0.0/0 开放 5050。生产环境主用那台就是这么做的（只走内网）。

# 前端访问地址：邮件里的链接（密码重置）用它拼绝对地址。
# 本地开发保持默认即可；**生产必须改成真实域名**，否则 ENV=prod 启动会直接报错。
# FRONTEND_URL=https://nlnoj.gr3yph4ntom.cn

# ---- Email Service ----
# SMTP配置（支持QQ邮箱、163邮箱、Gmail等）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_EMAIL=your-email@qq.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_NAME=NLNOJ
# 邮件头部图标的公网地址。注意必须是 PNG —— Gmail / Outlook 不渲染 SVG。
# EMAIL_LOGO_URL=https://nlnoj.gr3yph4ntom.cn/logo.png

# 发信限流：保护 SMTP 账号不被判定「异常发信」而封禁。
# 注册开学高峰如果被卡「系统发信繁忙」，把第一个值调大即可。
# EMAIL_SEND_GLOBAL_PER_HOUR=100
# EMAIL_SEND_PER_EMAIL_DAY=5
